@model POOI_T2_CruzAlcas.Models.Alumno
@{ ViewBag.Title = "Detalles del alumno"; }
<a class="back" href="@Url.Action("Index")">← Volver al listado</a>
<section class="heading"><div><p class="eyebrow">FICHA DEL ALUMNO</p><h1>Detalles</h1><p class="muted">Información del alumno seleccionado.</p></div></section>
<section class="card form-card">
    <h2>@Model.nombres @Model.apellidos</h2>
    <dl class="details">
        <dt>DNI</dt><dd>@Model.dni</dd>
        <dt>Nombres</dt><dd>@Model.nombres</dd>
        <dt>Apellidos</dt><dd>@Model.apellidos</dd>
        <dt>Carrera</dt><dd>@Model.carrera</dd>
        <dt>Ciclo</dt><dd>@Model.ciclo</dd>
    </dl>
    <div class="form-actions"><a class="button primary" href="@Url.Action("Actualizar", new { dni = Model.dni })">Actualizar alumno</a><a class="button secondary" href="@Url.Action("Index")">Volver</a></div>
</section>
