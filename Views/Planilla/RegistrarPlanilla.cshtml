@model POOI_T1_Cruz.Models.Empleado
@using POOI_T1_Cruz.Models

<h1>Registrar planilla</h1>

<form method="post">
    <label>ID:</label>
    <input asp-for="idEmpleado" />
    <br />

    <label>Nombres y apellidos:</label>
    <input asp-for="nomapeEmpleado" />
    <br />

    <label>Categoría:</label>
    <select asp-for="categoriaEmpleado">
        <option value="">-- Seleccione --</option>
        <option value="E1">E1</option>
        <option value="E2">E2</option>
        <option value="E3">E3</option>
        <option value="Otra">Otra</option>
    </select>
    <br />

    <label>Número de hijos:</label>
    <input asp-for="nHijos" type="number" min="0" />
    <br />

    <label>Tipo de contrato:</label>
    <select asp-for="tipoContrato">
        <option value="">-- Seleccione --</option>
        <option value="Indefinido">Indefinido</option>
        <option value="Contratado">Contratado</option>
    </select>
    <br />

    <button type="submit">REGISTRAR</button>
    <a asp-action="Nuevo">NUEVO</a>
</form>

<hr />

<h2>Planilla</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombres y apellidos</th>
            <th>Categoría</th>
            <th>Hijos</th>
            <th>Contrato</th>
            <th>Sueldo básico</th>
            <th>Escolaridad</th>
            <th>Bonificación</th>
            <th>Monto a pagar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Empleado empleado in (List<Empleado>)ViewBag.Planilla)
        {
            <tr>
                <td>@empleado.idEmpleado</td>
                <td>@empleado.nomapeEmpleado</td>
                <td>@empleado.categoriaEmpleado</td>
                <td>@empleado.nHijos</td>
                <td>@empleado.tipoContrato</td>
                <td>@empleado.SueldoBasico()</td>
                <td>@empleado.Escolaridad()</td>
                <td>@empleado.Bonificacion()</td>
                <td>@empleado.MontoAPagar()</td>
            </tr>
        }
    </tbody>
</table>
