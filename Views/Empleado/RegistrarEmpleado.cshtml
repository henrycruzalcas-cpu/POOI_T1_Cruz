@model POOI_T1_Cruz.Models.Empleado

<h1>Registrar empleado</h1>

<form method="post">
    <label>ID:</label>
    <input asp-for="idEmpleado" />
    <br />

    <label>Nombres y apellidos:</label>
    <input asp-for="nomapeEmpleado" />
    <br />

    <label>Categoría:</label>
    <select asp-for="categoriaEmpleado">
        <option value="">-- Seleccione --</option>
        <option value="E1">E1</option>
        <option value="E2">E2</option>
        <option value="E3">E3</option>
        <option value="Otra">Otra</option>
    </select>
    <br />

    <label>Número de hijos:</label>
    <input asp-for="nHijos" type="number" min="0" />
    <br />

    <label>Tipo de contrato:</label>
    <select asp-for="tipoContrato">
        <option value="">-- Seleccione --</option>
        <option value="Indefinido">Indefinido</option>
        <option value="Contratado">Contratado</option>
    </select>
    <br />

    <button type="submit">REGISTRAR</button>
</form>
@if (!string.IsNullOrEmpty(Model.idEmpleado))
{
    <hr />
    <h2>Resultados</h2>

    <label>Sueldo básico:</label>
    <input value="@Model.SueldoBasico()" readonly />
    <br />

    <label>Escolaridad:</label>
    <input value="@Model.Escolaridad()" readonly />
    <br />

    <label>Bonificación:</label>
    <input value="@Model.Bonificacion()" readonly />
    <br />

    <label>Monto a pagar:</label>
    <input value="@Model.MontoAPagar()" readonly />
}